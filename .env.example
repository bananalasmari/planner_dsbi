# Personal API Token from ClickUp (Settings → Apps). Never commit the real token.
CLICKUP_API_TOKEN=

# Optional: workspace (team) ID. From the URL: https://app.clickup.com/{TEAM_ID}/...
CLICKUP_TEAM_ID=

# Optional: Space ID. From the URL: https://app.clickup.com/{team}/v/s/{SPACE_ID}
CLICKUP_SPACE_ID=

# Optional: List ID. From the URL: https://app.clickup.com/{team}/v/li/{LIST_ID}
CLICKUP_LIST_ID=

# Optional: comma-separated parent Task IDs (Mazadat, Reach, …) instead of listing all top-level tasks.
CLICKUP_PARENT_TASK_IDS=

# Optional: ClickUp custom field ID for Features. If empty, the field named Features is used.
CLICKUP_FEATURES_FIELD_ID=

# Jira base URL — use your company instance (e.g. jira.elm.sa), not the browser alias only.
JIRA_BASE_URL=https://jira.elm.sa

# For jira.elm.sa (Data Center): Jira username (often without @domain).
JIRA_USERNAME=baalasmari

# For Atlassian Cloud (*.atlassian.net): account email instead of username.
# JIRA_EMAIL=you@elm.sa

# Personal Access Token from Jira profile (Data Center) or id.atlassian.com (Cloud).
# Data Center (jira.elm.sa): use Bearer auth — curl -H "Authorization: Bearer TOKEN" ...
# Do NOT use curl -u username:token on Data Center.
JIRA_API_TOKEN=

# UXUI SR queue (Service Desk). Queue ID defaults to 390.
JIRA_QUEUE_ID=390
JIRA_QUEUE_NAME=UXUI SR

# Optional: Service Desk ID if auto-discovery fails.
JIRA_SERVICE_DESK_ID=

# Optional: override queue JQL when queue API is unavailable.
# JIRA_QUEUE_JQL=project = DSBI AND statusCategory != Done ORDER BY updated DESC

# Optional: project key fallback when queue JQL is not resolved.
JIRA_PROJECT_KEY=DSBI

# Optional: custom field ID for Product Name. If empty, the field named "Product Name" is discovered automatically.
JIRA_PRODUCT_NAME_FIELD_ID=

# Cloud store (users + plans sync across devices). Use a long random string in production.
STORE_SECRET=change-me-to-a-long-random-secret

# Local server
PORT=3456
